# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_CONTRACT_REVIEW_TASK_QUEUE=contract-review
TEMPORAL_PDF_PROCESS_TASK_QUEUE=pdf-processing

# ── AWS / S3 (MinIO-compatible) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
TEMP_DIR=./tmp

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── LangSmith observability ──────────────────────────────────────────────────
# Tracing is off unless LANGSMITH_TRACING=true. Leave it unset for local runs
# when you don't need traces — the app works exactly the same without it.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-contract-review
# Optional: self-hosted / EU endpoint, or workspace selection
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
